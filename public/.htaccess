# 1. REGISTER CUSTOM MIME TYPES
AddType application/manifest+json .webmanifest

# 2. HTTPS ENFORCEMENT (Moved to the top)
RewriteEngine On
RewriteBase /
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3. CLEAN URL EXTENSIONS (SPA Routing Engine)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
RewriteRule ^index\.html$ - [L]

# 4. FORCE NO-CACHE FOR SERVICE WORKER, HTML, MANIFESTS, AND RSS FEEDS
# Moved above Section 5 so specific exceptions override generic rules
<FilesMatch "(sw\.js|rss\.xml|\.html|\.webmanifest)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# 5. IMMUTABLE LONG-TERM CACHING FOR BUNDLES (Excluding sw.js)
<FilesMatch "\.(js|css)$">
    <FilesMatch "sw\.js">
        # Nested block ensures sw.js doesn't accidentally inherit this long cache
    </FilesMatch>
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
</FilesMatch>

# 6. SECURITY HEADERS
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 7. PERFORMANCE: COMPRESSION
<IfModule mod_deflate.c>
    SetOutputFilter DEFLATE
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
    AddOutputFilterByType DEFLATE application/manifest+json
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|ico|zip|gz|mp4)$ no-gzip dont-vary
</IfModule>

# 8. PERFORMANCE: BROWSER CACHING (FALLBACKS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    RewriteCond %{REQUEST_FILENAME} !-f
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 0 seconds"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
