{
  "name": "spa-template",
  "version": "0.0.1",
  "description": "Basic webapp template using jest, babel and webpack. Used as a starting point for other projects",
  "homepage": "https://github.com/leighgordy/spa-template#readme",
  "bugs": {
    "url": "https://github.com/leighgordy/spa-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leighgordy/spa-template.git"
  },
  "license": "MIT",
  "author": "Leigh G",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "prettier . --write",
    "validate": "tsc --noEmit",
    "serve": "webpack serve --mode development",
    "prebuild": "prettier . --check && tsc --noEmit",
    "build": "webpack",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/jest": "^30.0.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "prettier": "3.9.6",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "@babel/core": "^8.0.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
